{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "fluid": true,
  "functions": {
    "app/main.py": {
      "maxDuration": 30,
      "excludeFiles": "{.env,.env.local,.env.prod,dump.rdb,tests/**,.venv/**,.git/**,.pytest_cache/**,.ruff_cache/**,.agents/**,.claude/**,nginx/**,demo*.html}"
    }
  }
}
